// EXPECT: pass
// STAGE: final-asm
// CONTAINS:
// - MOV PB, ?1
// - CALLB #?2
// - RETB WCZ
// ! abi_rec_countdown_arg0 LONG ?
// ! g_rec_countdown_ret0 LONG ?
// NOTE:
//   Covers recursive ABI lowering for a void-returning rec fn so the
//   shared PB argument slot is exercised without allocating a return slot.
cog task main {
    
    rec fn countdown(bound: u32) {
        if (bound > 0) {
            countdown(bound - 1);
        }
    }
    
    cog var start: u32 = 3;
    countdown(start);
}
