// EXPECT: pass
// STAGE: final-asm
// CONTAINS:
// - __asm_0_0_loop_start
// - JMP #__asm_0_0_loop_start
// NOTE:
//   Covers inline asm lowering with labels and comments.
//   Exercises AsmLowerer L918-923 (label lowering with comments).

cog task main {
  asm {
      // comment before label
      NOP
    loop_start:
      // comment after label
      NOP
      JMP #loop_start
  };
}
