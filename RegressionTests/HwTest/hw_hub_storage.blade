// EXPECT: pass-hw
// RUNS:
// - [ 0x42 ] = [ 0x42, 0x42, 0x42 ]
// - [ 0x1FF ] = [ 0xFF, 0x1FF, 0x1FF ]
// - [ 0x1234 ] = [ 0x34, 0x1234, 0x1234 ]
// - [ 0xDEADBEEF ] = [ 0xEF, 0xBEEF, 0xDEADBEEF ]
// NOTE:
//   XFAIL: RDBYTE/RDWORD return 0 for hub addresses beyond 9-bit immediate range.
//   Tests hub var read/write for u8, u16, and u32 widths.
//   f(x): writes x to h8 (truncates to u8), h16 (truncates to u16), h32 (full u32)
//         then reads all three back into separate result lanes.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_result2: u32;
    extern cog var rt_param0: u32;
    
    hub var h8:  u8  = 0;
    hub var h16: u16 = 0;
    hub var h32: u32 = 0;
    
    h8  = rt_param0 as u8;
    h16 = rt_param0 as u16;
    h32 = rt_param0;

    rt_result = h8 as u32;
    rt_result1 = h16 as u32;
    rt_result2 = h32;
}