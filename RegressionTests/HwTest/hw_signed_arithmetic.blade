// EXPECT: pass-hw
// RUNS:
// - [ -50, 30 ] = [ -20, -80, 50 ]
// - [ -10, -20 ] = [ -30, 10, 10 ]
// - [ 0, 0 ] = [ 0, 0, 0 ]
// - [ 100, 200 ] = [ 300, -100, -100 ]
// NOTE:
//   Tests i32 signed arithmetic: add, sub, negate.
//   Reports the signed sum, difference, and negation lanes separately.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_result2: u32;
    extern cog var rt_param0: i32;
    extern cog var rt_param1: i32;

    rt_result = bitcast(u32, rt_param0 + rt_param1);
    rt_result1 = bitcast(u32, rt_param0 - rt_param1);
    rt_result2 = bitcast(u32, -rt_param0);
}