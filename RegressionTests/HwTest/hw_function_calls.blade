// EXPECT: pass-hw
// RUNS:
// - [ 10 ] = [ 100, 110 ]
// - [ 0 ] = [ 0, 0 ]
// - [ 1 ] = [ 1, 2 ]
// - [ 5 ] = [ 25, 30 ]
// NOTE:
//   Tests nested noinline function calls.
//   compute(x) = add(mul(x,x), x) = x*x+x
//   Reports the nested multiplication and final compute result separately.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_param0: u32;
    
    noinline fn add(a: u32, b: u32) -> u32 {
        return a + b;
    }
    
    noinline fn mul(a: u32, b: u32) -> u32 {
        return a * b;
    }
    
    noinline fn compute(x: u32) -> u32 {
        return add(mul(x, x), x);
    }
    
    rt_result = mul(rt_param0, rt_param0);
    rt_result1 = compute(rt_param0);
}