// EXPECT: pass-hw
// RUNS:
// - [ 10, 20 ] = [ 30, 30 ]
// - [ 0, 0 ] = [ 0, 0 ]
// - [ 1, 0xFFFFFFFF ] = [ 0, 0 ]
// - [ 100, 200 ] = [ 300, 300 ]
// NOTE:
//   Tests asm fn -> u32 and inline asm volatile block.
//   Reports the asm-fn and inline-asm sums as separate result lanes.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_param0: u32;
    extern cog var rt_param1: u32;
    
    asm fn asm_sum(a: u32, b: u32) -> u32 {
        ADD {a}, {b}
        MOV {return}, {a}
    }
    
    noinline fn inline_sum(a: u32, b: u32) -> u32 {
        var r: u32 = 0;
        asm volatile {
            ADD {r}, {a}
            ADD {r}, {b}
        };
        return r;
    }
    
    rt_result = asm_sum(rt_param0, rt_param1);
    rt_result1 = inline_sum(rt_param0, rt_param1);
}