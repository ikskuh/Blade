// EXPECT: pass-hw
// RUNS:
// - [ 0x80000001, 4 ] = [ 0x10, 0x08000000, 0x1F, 0xF8000000, 0x18, 0x18000000 ]
// - [ 0x12345678, 0 ] = [ 0x12345678, 0x12345678, 0x12345678, 0x12345678, 0x12345678, 0x12345678 ]
// - [ 0x00000001, 1 ] = [ 2, 0, 3, 0, 2, 0x80000000 ]
// - [ 0x80000000, 31 ] = [ 0, 1, 0, 0xFFFFFFFF, 0x40000000, 1 ]
// NOTE:
//   Tests all shift and rotate operators on u32.
//   Reports each shift/rotate operator in its own result lane.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_result2: u32;
    extern cog var rt_result3: u32;
    extern cog var rt_result4: u32;
    extern cog var rt_result5: u32;
    extern cog var rt_param0: u32;
    extern cog var rt_param1: u32;

    rt_result = rt_param0 << rt_param1;
    rt_result1 = rt_param0 >> rt_param1;
    rt_result2 = rt_param0 <<< rt_param1;
    rt_result3 = rt_param0 >>> rt_param1;
    rt_result4 = rt_param0 <%< rt_param1;
    rt_result5 = rt_param0 >%> rt_param1;
}