// EXPECT: pass-hw
// RUNS:
// - [ 100, 200 ] = [ 200, 100 ]
// - [ 200, 100 ] = [ 200, 100 ]
// - [ 50, 50 ] = [ 50, 50 ]
// - [ 0, 0xFFFFFFFF ] = [ 0xFFFFFFFF, 0 ]
// NOTE:
//   Tests if-else expressions (ternary select).
//   Reports the selected max and min lanes separately.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_param0: u32;
    extern cog var rt_param1: u32;
    
    noinline fn max(a: u32, b: u32) -> u32 {
        return if (a > b) a else b;
    }
    
    noinline fn min(a: u32, b: u32) -> u32 {
        return if (a < b) a else b;
    }
    
    rt_result = max(rt_param0, rt_param1);
    rt_result1 = min(rt_param0, rt_param1);
}