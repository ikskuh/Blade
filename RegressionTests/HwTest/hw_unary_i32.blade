// EXPECT: pass-hw
// RUNS:
// - [ 42 ] = [ -42, 42, -43 ]
// - [ 0 ] = [ 0, 0, -1 ]
// - [ -1 ] = [ 1, -1, 0 ]
// NOTE:
//   Tests unary operators on i32: negate, plus, bitwise not.
//   Reports negate, unary plus, and bitwise-not as separate signed result lanes.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_result2: u32;
    extern cog var rt_param0: i32;

    rt_result = bitcast(u32, -rt_param0);
    rt_result1 = bitcast(u32, +rt_param0);
    rt_result2 = bitcast(u32, ~rt_param0);
}