// EXPECT: pass-hw
// RUNS:
// - [ 10, 3 ] = [ 13, 7, 30, 3, 1 ]
// - [ 0, 1 ] = [ 1, 0xFFFFFFFF, 0, 0, 0 ]
// - [ 1, 1 ] = [ 2, 0, 1, 1, 0 ]
// - [ 100, 7 ] = [ 107, 93, 700, 14, 2 ]
// - [ 0xFFFFFFFF, 1 ] = [ 0, 0xFFFFFFFE, 0xFFFFFFFF, 0xFFFFFFFF, 0 ]
// NOTE:
//   Tests u32 arithmetic operators by reporting each result lane separately.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_result2: u32;
    extern cog var rt_result3: u32;
    extern cog var rt_result4: u32;
    extern cog var rt_param0: u32;
    extern cog var rt_param1: u32;

    rt_result = rt_param0 + rt_param1;
    rt_result1 = rt_param0 - rt_param1;
    rt_result2 = rt_param0 * rt_param1;
    rt_result3 = rt_param0 / rt_param1;
    rt_result4 = rt_param0 % rt_param1;
}