// EXPECT: pass-hw
// RUNS:
// - [ 0x42 ] = [ 0x42, 0 ]
// - [ 0x1FF ] = [ 0xFF, 0 ]
// - [ 0x80000000 ] = [ 0, 1 ]
// - [ 0xDEADBEEF ] = [ 0xEF, 1 ]
// NOTE:
//   Regression for the combined cast/sign path that originally exposed BUG-4 and
//   BUG-5 together. The low byte must truncate through `as u8 as u32`, and the
//   sign lane must detect `bitcast(i32, x) < 0` via signed lowering.
//   Reports the truncated byte lane and the signed-negativity lane separately.
cog task main {
    
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_param0: u32;

    noinline fn narrow_byte(x: u32) -> u32 {
        var byte_val: u8 = x as u8;
        return byte_val as u32;
    }

    noinline fn is_negative_signed(x: u32) -> u32 {
        var signed: i32 = bitcast(i32, x);
        return if (signed < 0) 1 else 0;
    }

    rt_result = narrow_byte(rt_param0);
    rt_result1 = is_negative_signed(rt_param0);
}