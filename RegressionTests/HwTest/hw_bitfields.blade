// EXPECT: pass-hw
// RUNS:
// - [ 0xAB, 0xCD ] = [ 0xAB, 0xCD ]
// - [ 0, 0 ] = [ 0, 0 ]
// - [ 0xFF, 0xFF ] = [ 0xFF, 0xFF ]
// - [ 1, 0x80 ] = [ 1, 0x80 ]
// NOTE:
//   Tests bitfield field write and read via bitcast.
//   Flags = bitfield(u32) { lo: u8 (bits 0-7), mid: u8 (bits 8-15), hi: u16 (bits 16-31) }
//   f(a,b): write lo=a as u8, mid=b as u8, then report each field separately.

type Flags = bitfield(u32) {
    lo:  u8,
    mid: u8,
    hi:  u16,
};

cog task main {
    extern cog var rt_result: u32;
    extern cog var rt_result1: u32;
    extern cog var rt_param0: u32;
    extern cog var rt_param1: u32;
    
    noinline fn pack_unpack(a: u32, b: u32) -> Flags {
        var f: Flags = bitcast(Flags, 0);
        f.lo  = a as u8;
        f.mid = b as u8;
        return f;
    }
    
    var unpacked: Flags = pack_unpack(rt_param0, rt_param1);
    rt_result = unpacked.lo as u32;
    rt_result1 = unpacked.mid as u32;
}