// EXPECT: pass
// STAGE: final-asm
// SEQUENCE:
// - f_factorial
// - PUSHB ?1
// - CALLB #f_factorial
// - MOV ?2, ?1
// - POPB ?1
// - QMUL ?1, ?2
// NOTE:
//   Recursive calls spill the live caller value across CALLB. The recursive
//   lowering now preserves the live caller input in PB and restores that register
//   after the call before multiplying it with the returned PA result.
cog task main {
    
    rec fn factorial(n: u32) -> u32 {
        if (n < 2) {
            return 1;
        }
    
        return n * factorial(n - 1);
    }
    
    cog var input: u32 = 6;
    cog var sink: u32 = 0;
    
    sink = factorial(input);
}