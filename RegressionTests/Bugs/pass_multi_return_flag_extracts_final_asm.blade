// EXPECT: pass
// STAGE: final-asm
// SEQUENCE:
// - CALLPA ?, #f_three_ret
// - MOV ?1, PA
// - WRC ?2
// - WRZ ?2
// SEQUENCE:
// - f_three_ret
// - three_ret_bb0
// - MOV ?1, PA
// - MOV PA, ?1
// - ADD PA, ?2
// - CMP ?1, ?2 WC
// - CMP ?1, ?2 WZ
// - WRC PA
// - TESTB PA, #0 WC
// - WRZ ?3
// - TESTB ?3, #0 WZ
// CONTAINS:
// - CALLPA ?, #f_two_ret
// - WRC ?
// NOTE:
//   Multi-return calls with bool extras must materialize both flag-backed extra
//   results immediately after the call. The three-return caller must extract C and
//   Z separately through register writes. The leaf callees currently normalize
//   those flag-backed extras with WRC/WRZ plus TESTB before returning. The
//   two-return case must still extract C.
cog task main {
    
    noinline fn two_ret(a: u32, b: u32) -> u32, bool {
        return a + b, (a < b);
    }
    
    noinline fn three_ret(a: u32, b: u32) -> u32, bool, bool {
        return a + b, (a < b), (a == b);
    }
    
    cog var left: u32 = 5;
    cog var right: u32 = 5;
    cog var sum2: u32 = 0;
    cog var lt2: bool = false;
    cog var sum3: u32 = 0;
    cog var lt3: bool = false;
    cog var eq3: bool = false;
    
    sum2, lt2 = two_ret(left, right);
    sum3, lt3, eq3 = three_ret(left, right);
}