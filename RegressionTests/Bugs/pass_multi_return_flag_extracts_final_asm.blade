// EXPECT: xfail
// STAGE: final-asm
// SEQUENCE:
// - CALLPA ?, #f_three_ret
// - MOV ?, PA
// - WRC ?
// - WRZ ?
// SEQUENCE:
// - f_three_ret
// - three_ret_bb0
// - MOV ?1, PA
// - MOV PA, ?1
// - ADD PA, ?2
// - CMP ?1, ?2 WC
// - CMP ?1, ?2 WZ
// ! WRC
// ! WRZ
// - RET
// SEQUENCE:
// - f_two_ret
// - MOV ?1, PA
// - MOV PA, ?1
// - ADD PA, ?2
// - CMP ?1, ?2 WC
// ! WRC
// ! WRZ
// - RET WZ
// CONTAINS:
// - CALLPA ?, #f_two_ret
// - WRC ?
// NOTE:
//   currently fails due to pattern matching bug?
// NOTE:
//   Multi-return calls with bool extras must materialize both flag-backed extra
//   results immediately after the call. The three-return caller must extract C and
//   Z separately through register writes. The leaf callee returns both flags
//   directly with a bare RET, so it must not normalize them through WRC/WRZ
//   plus TESTB. The two-return case must still extract C.
cog task main {
    
    noinline fn two_ret(a: u32, b: u32) -> u32, bool {
        return a + b, (a < b);
    }
    
    noinline fn three_ret(a: u32, b: u32) -> u32, bool, bool {
        return a + b, (a < b), (a == b);
    }
    
    cog var left: u32 = 5;
    cog var right: u32 = 5;
    cog var sum2: u32 = 0;
    cog var lt2: bool = false;
    cog var sum3: u32 = 0;
    cog var lt3: bool = false;
    cog var eq3: bool = false;
    
    sum2, lt2 = two_ret(left, right);
    sum3, lt3, eq3 = three_ret(left, right);
}
