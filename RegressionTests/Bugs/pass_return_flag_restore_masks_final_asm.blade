// EXPECT: pass
// STAGE: final-asm
// SEQUENCE:
// - f_ret_c
// - ret_c_bb0
// - CMP ?1, ?2 WC
// - RET WZ
// SEQUENCE:
// - f_ret_z
// - ret_z_bb0
// - CMP ?1, ?2 WZ
// - RET WC
// NOTE:
//   Exercises direct return-flag lowering for single-flag returns. Returning a
//   C-backed bool must restore only Z (`RET WZ`), while returning a Z-backed
//   bool must restore only C (`RET WC`).
cog task main {
    
    noinline fn ret_c(a: u32, b: u32) -> u32, bool {
        return a + b, (a < b);
    }
    
    noinline fn ret_z(a: u32, b: u32) -> u32, bool@Z {
        return a + b, (a == b);
    }
    
    cog var left: u32 = 5;
    cog var right: u32 = 5;
    cog var sum_c: u32 = 0;
    cog var sum_z: u32 = 0;
    cog var less: bool = false;
    cog var equal: bool = false;
    
    sum_c, less = ret_c(left, right);
    sum_z, equal = ret_z(left, right);
}
