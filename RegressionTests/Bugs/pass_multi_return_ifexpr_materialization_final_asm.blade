// EXPECT: pass
// STAGE: final-asm
// CONTAINS:
// - MOV ?, #0
// - TESTB ?, #0 WZ
// - TESTB ?, #0 WZ
// - IF_Z JMP #?
// - IF_Z JMP #?
// NOTE:
//   Bool values captured from multi-return calls and then converted via
//   `if (flag) 1 else 0` must keep an explicit false-branch overwrite and test
//   the normalized bool values captured from the multi-return call. The true
//   path may reuse the already materialized `1` value instead of reassigning it.
cog task main {
    
    noinline fn two_ret(a: u32, b: u32) -> u32, bool {
        return a + b, (a < b);
    }
    
    noinline fn three_ret(a: u32, b: u32) -> u32, bool, bool {
        return a + b, (a < b), (a == b);
    }
    
    cog var sum2: u32 = 0;
    cog var lt2: bool = false;
    cog var sum3: u32 = 0;
    cog var lt3: bool = false;
    cog var eq3: bool = false;
    cog var lt2_u: u32 = 0;
    cog var eq3_u: u32 = 0;
    
    sum2, lt2 = two_ret(3, 4);
    sum3, lt3, eq3 = three_ret(5, 5);
    lt2_u = if (lt2) 1 else 0;
    eq3_u = if (eq3) 1 else 0;
}