// EXPECT: pass
// STAGE: final-asm
// CONTAINS:
// - CALLPB ?, #?2
// - CALLPA ?, #?3
// - MOV PB, PA
// - ADD PB, #1
// SEQUENCE:
// - ?2
// - wrap_sub_bb0
// ! MOV PB, ?
// - CALLPA PB, #?3
// - MOV PB, PA
// - ADD PB, #1
// - RET WCZ
// SEQUENCE:
// - ?3
// - leaf_sub_bb0
// ! MOV PA, ?
// - SUB PA, ?
// - RET WCZ
// ! SUB PA, PA
// NOTE:
//   Covers an auto-tiered second-order function that forwards a second
//   parameter into a leaf callee while keeping PB as the transport/result slot
//   without materializing arg0 through an extra entry register.
cog task main {
    
    noinline leaf fn leaf_sub(a: u32, b: u32) -> u32 {
        return a - b;
    }
    
    noinline fn wrap_sub(a: u32, b: u32) -> u32 {
        return leaf_sub(a, b) + 1;
    }
    
    cog var left: u32 = 10;
    cog var right: u32 = 3;
    cog var sink: u32 = 0;
    
    sink = wrap_sub(left, right);
}