// EXPECT: pass
// STAGE: final-asm
// CONTAINS:
// - CALLPA ?, #?2
// SEQUENCE:
// - ?2
// - leaf_sub_bb0
// ! MOV PA, ?
// - SUB PA, ?
// - RET WCZ
// ! SUB PA, PA
// NOTE:
//   Covers a two-parameter leaf function. Parameter 0 now stays in PA for the
//   leaf body, while parameter 1 still travels through a shared ABI slot.
cog task main {
    
    noinline leaf fn leaf_sub(a: u32, b: u32) -> u32 {
        return a - b;
    }
    
    cog var left: u32 = 10;
    cog var right: u32 = 3;
    cog var sink: u32 = 0;
    
    sink = leaf_sub(left, right);
}