// EXPECT: pass
// STAGE: asmir
// ARGS:
// - -fno-mir-opt=*
// - -fno-mir-opt=single-callsite-inline
// - -fno-lir-opt=*
// - -fno-asmir-opt=*
// - -fasmir-opt=ret-fusion
// CONTAINS:
// - _RET_ MOV PA, #10
// NOTE:
//   Positive case for ASMIR ret-fusion: the RET should fuse into the preceding
//   register handoff instead of surviving as a standalone terminator.
cog task main {
    
    cog var sink1: u32 = 0;
    cog var sink2: bool = false;
    cog var sink3: bool = false;
    
    noinline asm fn fusable() -> u32, bool@C, bool@Z {
        MOV INA, #0 WCZ
        MOV {return}, #10
        RET
    }
    
    
    sink1, sink2, sink3 = fusable();
}